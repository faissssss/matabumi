# Production Environment Variables for MataBumi Frontend
# 
# IMPORTANT: Copy this file to .env.production and configure for your deployment
#
# For Vercel deployment:
# 1. If you have a backend API deployed, set VITE_API_BASE_URL to your API URL
# 2. If you DON'T have a backend, leave it as /api (app will run in demo mode)
# 3. Configure the backend URL in vercel.json rewrites section

# Option 1: With Backend API (recommended for production)
# VITE_API_BASE_URL=https://your-backend-api.com

# Option 2: Without Backend (demo mode - current setup)
VITE_API_BASE_URL=/api

# Note: When using /api, the app will gracefully handle missing backend
# and display appropriate empty states to users
