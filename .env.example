# MataBumi Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git - it contains secrets!

# ============================================================================
# MICROSOFT PLANETARY COMPUTER API (OPTIONAL)
# ============================================================================
# API key is OPTIONAL - the service works without it!
# 
# Without a key:
#   - Unauthenticated access works fine for research/experimentation
#   - More rate limiting on SAS token generation (but usually sufficient)
#
# With a key:
#   - Reduced rate limiting
#   - Better for heavy usage scenarios
#
# Note: The free API key system was retired on June 6, 2024 with the 
# Planetary Computer Hub. For heavy production usage, consider 
# Planetary Computer Pro (paid): https://planetarycomputer.microsoft.com/
#
# Leave blank or comment out if not using an API key
# PLANETARY_COMPUTER_API_KEY=your_planetary_computer_api_key_here

# ============================================================================
# DETECTION CONFIGURATION
# ============================================================================
# NDVI change threshold for deforestation detection (0.0 to 1.0)
# Default: 0.2 (20% vegetation loss)
NDVI_CHANGE_THRESHOLD=0.2

# Maximum cloud cover percentage for usable imagery (0-100)
# Default: 15% (will retry with 25% if no images found)
CLOUD_COVER_MAX=15

# Minimum deforestation area to record as alert (hectares)
# Default: 50 hectares
MINIMUM_ALERT_AREA=50

# Minimum confidence score to store alert (0.0 to 1.0)
# Default: 0.6 (60% confidence)
CONFIDENCE_THRESHOLD=0.6

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Path to SQLite database file (relative to project root)
# Default: backend/database/matabumi.db
DATABASE_PATH=backend/database/matabumi.db

# ============================================================================
# OUTPUT DIRECTORIES
# ============================================================================
# Directory for hero images (before/after/change visualizations)
# Default: outputs
OUTPUT_DIR=outputs

# Directory for satellite thumbnail images
# Default: outputs/thumbnails
THUMBNAIL_DIR=outputs/thumbnails

# ============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# ============================================================================
# Satellite imagery resolution in meters (10, 30, or 60)
# Default: 60 (faster processing, lower memory usage)
# RESOLUTION=60

# Maximum number of parallel province processing workers
# Default: 4
# MAX_WORKERS=4

# Province processing timeout in seconds
# Default: 600 (10 minutes)
# PROVINCE_TIMEOUT=600
