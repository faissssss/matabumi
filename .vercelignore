# Python and backend
# Allow api directory for Vercel functions
!api/
!api/*.py
!api/**/*.py
!api/database/*.db

# Python cache and temp files
.pytest_cache/
.hypothesis/
__pycache__/
*.pyc
*.db-journal

# Exclude these directories (not needed for deployment)
pipeline/
detection/
tests/
test_artifacts/

# Root-level data and outputs only (not frontend/src/data)
/data/
/outputs/

# Documentation (except README)
*.md
!README.md

# Config and temp files
.env
.env.local

# IDE
.vscode/
.idea/
.kiro/
.agents/

# Plans
plans/
